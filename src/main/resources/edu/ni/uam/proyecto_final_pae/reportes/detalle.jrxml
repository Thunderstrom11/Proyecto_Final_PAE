<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="DetalleViajes" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
    <style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0" forecolor="#20344A"/>
    <style name="Celda" fontName="DejaVu Sans" fontSize="8.0"><box leftPadding="5" rightPadding="5" topPadding="5" bottomPadding="5"><bottomPen lineWidth="0.4" lineColor="#DDE4EB"/></box></style>
    <style name="Encabezado" mode="Opaque" backcolor="#EAF0F7" bold="true" fontSize="9.0" vTextAlign="Middle"><box leftPadding="5" rightPadding="5"/></style>
    <parameter name="EMPRESA" class="java.lang.String"/>
    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="FILTROS" class="java.lang.String"/>
    <parameter name="GENERADO" class="java.lang.String"/>
    <parameter name="METRICAS" class="java.lang.String"/>
    <parameter name="CATEGORIA" class="java.lang.String"/>
    <parameter name="GRAFICO" class="java.awt.Image"/>
    <parameter name="NOTA_GRAFICO" class="java.lang.String"/>
    <parameter name="VACIO" class="java.lang.Boolean"/>
    <field name="viaje" class="java.lang.String"/>
    <field name="carga" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="operador" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="inicio" class="java.lang.String"/>
    <field name="fin" class="java.lang.String"/>
    <field name="importe" class="java.lang.String"/>
    <title height="214" splitType="Stretch">
        <element kind="textField" x="0" y="0" width="782" height="28" fontSize="18.0" bold="true" textAdjust="StretchHeight"><expression><![CDATA[$P{EMPRESA}]]></expression></element>
        <element kind="textField" positionType="Float" x="0" y="34" width="782" height="27" fontSize="16.0" bold="true"><expression><![CDATA[$P{TITULO}]]></expression></element>
        <element kind="textField" positionType="Float" x="0" y="66" width="782" height="18" fontSize="8.0" forecolor="#586B7E"><expression><![CDATA[$P{GENERADO}]]></expression></element>
        <element kind="textField" positionType="Float" x="0" y="88" width="782" height="48" textAdjust="StretchHeight"><expression><![CDATA[$P{FILTROS}]]></expression></element>
        <element kind="textField" positionType="Float" x="0" y="145" width="782" height="34" textAdjust="StretchHeight" bold="true" fontSize="10.0"><expression><![CDATA[$P{METRICAS}]]></expression></element>
        <element kind="staticText" positionType="Float" x="0" y="185" width="782" height="24" forecolor="#586B7E"><printWhenExpression><![CDATA[$P{VACIO}]]></printWhenExpression><text><![CDATA[No hay viajes que coincidan con los filtros.]]></text></element>
    </title>
    <pageHeader height="20">
        <element kind="textField" x="0" y="0" width="782" height="16" textAdjust="StretchHeight" fontSize="8.0" forecolor="#586B7E"><printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression><expression><![CDATA[$P{EMPRESA} + " | " + $P{TITULO}]]></expression></element>
    </pageHeader>
    <columnHeader height="26">
        <element kind="staticText" x="0" y="0" width="40" height="26" style="Encabezado"><text><![CDATA[Viaje]]></text></element>
        <element kind="staticText" x="40" y="0" width="80" height="26" style="Encabezado"><text><![CDATA[Carga]]></text></element>
        <element kind="staticText" x="120" y="0" width="130" height="26" style="Encabezado"><text><![CDATA[Cliente]]></text></element>
        <element kind="staticText" x="250" y="0" width="140" height="26" style="Encabezado"><text><![CDATA[Operador]]></text></element>
        <element kind="staticText" x="390" y="0" width="65" height="26" style="Encabezado"><text><![CDATA[Unidad]]></text></element>
        <element kind="staticText" x="455" y="0" width="105" height="26" style="Encabezado"><text><![CDATA[Inicio]]></text></element>
        <element kind="staticText" x="560" y="0" width="105" height="26" style="Encabezado"><text><![CDATA[Finalización]]></text></element>
        <element kind="staticText" x="665" y="0" width="117" height="26" style="Encabezado"><text><![CDATA[Importe]]></text></element>
    </columnHeader>
    <detail>
        <band height="26" splitType="Prevent">
            <element kind="textField" x="0" y="0" width="40" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{viaje}]]></expression></element>
            <element kind="textField" x="40" y="0" width="80" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{carga}]]></expression></element>
            <element kind="textField" x="120" y="0" width="130" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{cliente}]]></expression></element>
            <element kind="textField" x="250" y="0" width="140" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{operador}]]></expression></element>
            <element kind="textField" x="390" y="0" width="65" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{unidad}]]></expression></element>
            <element kind="textField" x="455" y="0" width="105" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{inicio}]]></expression></element>
            <element kind="textField" x="560" y="0" width="105" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Left" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{fin}]]></expression></element>
            <element kind="textField" x="665" y="0" width="117" height="26" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Right" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{importe}]]></expression></element>
        </band>
    </detail>
    <pageFooter height="24">
        <element kind="staticText" x="0" y="7" width="652" height="15" fontSize="7.0" forecolor="#586B7E"><text><![CDATA[Cobro registrado de viajes finalizados.]]></text></element>
        <element kind="textField" x="652" y="7" width="130" height="15" hTextAlign="Right" fontSize="8.0"><expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression></element>
    </pageFooter>
    <summary height="285" splitType="Prevent">
        <printWhenExpression><![CDATA[$P{GRAFICO} != null]]></printWhenExpression>
        <element kind="image" x="0" y="12" width="782" height="245" scaleImage="RetainShape"><expression><![CDATA[$P{GRAFICO}]]></expression></element>
        <element kind="textField" x="0" y="262" width="782" height="20" fontSize="8.0" forecolor="#586B7E"><expression><![CDATA[$P{NOTA_GRAFICO}]]></expression></element>
    </summary>
</jasperReport>
