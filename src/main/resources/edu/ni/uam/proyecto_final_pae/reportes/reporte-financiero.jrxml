<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_financiero" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="38" bottomMargin="35"
              whenNoDataType="AllSectionsNoDetail">
    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10" forecolor="#1B2B44"/>
    <style name="EncabezadoColumna" style="Base" mode="Opaque" forecolor="#FFFFFF" backcolor="#1B2B44" isBold="true">
        <box leftPadding="8" rightPadding="8"/>
    </style>
    <style name="Celda" style="Base">
        <box topPadding="3" leftPadding="8" bottomPadding="3" rightPadding="8">
            <bottomPen lineWidth="0.5" lineColor="#DDE6F2"/>
        </box>
    </style>

    <parameter name="EMPRESA" class="java.lang.String"/>
    <parameter name="PERIODO" class="java.lang.String"/>
    <parameter name="RESUMEN" class="java.lang.String"/>

    <field name="seccion" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="viajes" class="java.lang.Long"/>
    <field name="total" class="java.lang.String"/>

    <group name="Desglose" isReprintHeaderOnEachPage="true" minHeightToStartNewPage="80">
        <groupExpression><![CDATA[$F{seccion}]]></groupExpression>
        <groupHeader>
            <band height="57" splitType="Prevent">
                <printWhenExpression><![CDATA[$F{seccion} != null]]></printWhenExpression>
                <textField>
                    <reportElement x="0" y="12" width="515" height="23"/>
                    <textElement verticalAlignment="Middle">
                        <font size="14" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Total facturado por " + $F{seccion}.toLowerCase(java.util.Locale.ROOT)]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="EncabezadoColumna" x="0" y="35" width="303" height="22"/>
                    <textElement verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="EncabezadoColumna" x="303" y="35" width="74" height="22"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"/>
                    <text><![CDATA[Viajes]]></text>
                </staticText>
                <staticText>
                    <reportElement style="EncabezadoColumna" x="377" y="35" width="138" height="22"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"/>
                    <text><![CDATA[Total facturado]]></text>
                </staticText>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="150" splitType="Prevent">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="4" backcolor="#1F766F"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="16" width="515" height="17" forecolor="#1F766F"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[FleetRoute Pro]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="515" height="35"/>
                <textElement><font size="25" isBold="true"/></textElement>
                <text><![CDATA[Reporte financiero]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="73" width="515" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement positionType="Float" x="0" y="94" width="515" height="17" forecolor="#5D6B82"/>
                <textFieldExpression><![CDATA[$P{PERIODO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement positionType="Float" mode="Opaque" x="0" y="122" width="515" height="28" backcolor="#E8F3F1"/>
                <box leftPadding="8" rightPadding="8"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{RESUMEN}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="23" splitType="Prevent">
            <textField textAdjust="StretchHeight">
                <reportElement style="Celda" x="0" y="0" width="303" height="23"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Celda" stretchType="ContainerHeight" x="303" y="0" width="74" height="23"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{viajes}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Celda" stretchType="ContainerHeight" x="377" y="0" width="138" height="23"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="23">
            <line>
                <reportElement x="0" y="0" width="515" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#DDE6F2"/></graphicElement>
            </line>
            <textField>
                <reportElement x="385" y="6" width="130" height="15" forecolor="#5D6B82"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="34">
            <printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression>
            <staticText>
                <reportElement x="0" y="13" width="515" height="21" forecolor="#5D6B82"/>
                <text><![CDATA[No hay viajes finalizados para el período seleccionado.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
