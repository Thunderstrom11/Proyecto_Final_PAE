<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ReporteJornadas" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
    <style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0" forecolor="#20344A"/>
    <style name="Celda" fontName="DejaVu Sans" fontSize="8.0"><box leftPadding="5" rightPadding="5" topPadding="5" bottomPadding="5"><bottomPen lineWidth="0.4" lineColor="#DDE4EB"/></box></style>
    <style name="Encabezado" mode="Opaque" backcolor="#EAF0F7" bold="true" fontSize="8.5" vTextAlign="Middle"><box leftPadding="5" rightPadding="5"/></style>
    <parameter name="EMPRESA" class="java.lang.String"/>
    <parameter name="GENERADO" class="java.lang.String"/>
    <parameter name="FILTROS" class="java.lang.String"/>
    <parameter name="METRICAS" class="java.lang.String"/>
    <parameter name="VACIO" class="java.lang.Boolean"/>
    <field name="operador" class="java.lang.String"/>
    <field name="limites" class="java.lang.String"/>
    <field name="subtotal" class="java.lang.String"/>
    <field name="viaje" class="java.lang.String"/>
    <field name="carga" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="inicio" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="manejo" class="java.lang.String"/>
    <field name="tramo" class="java.lang.String"/>
    <field name="descanso" class="java.lang.String"/>
    <field name="pausas" class="java.lang.String"/>
    <field name="resultado" class="java.lang.String"/>
    <field name="incumple" class="java.lang.Boolean"/>
    <group name="Operador" minHeightToStartNewPage="90">
        <expression><![CDATA[$F{operador}]]></expression>
        <groupHeader>
            <band height="40" splitType="Prevent">
                <element kind="textField" x="0" y="6" width="782" height="18" fontSize="11.0" bold="true" textAdjust="StretchHeight"><expression><![CDATA["Operador: " + $F{operador}]]></expression></element>
                <element kind="textField" positionType="Float" x="0" y="24" width="782" height="14" fontSize="8.0" forecolor="#586B7E" textAdjust="StretchHeight"><expression><![CDATA[$F{limites}]]></expression></element>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="26" splitType="Prevent">
                <element kind="textField" x="0" y="4" width="782" height="18" fontSize="8.5" bold="true" textAdjust="StretchHeight"><expression><![CDATA[$F{subtotal}]]></expression></element>
            </band>
        </groupFooter>
    </group>
    <title height="236" splitType="Stretch">
        <element kind="textField" x="0" y="0" width="782" height="28" fontSize="18.0" bold="true" textAdjust="StretchHeight"><expression><![CDATA[$P{EMPRESA}]]></expression></element>
        <element kind="staticText" positionType="Float" x="0" y="34" width="782" height="27" fontSize="16.0" bold="true"><text><![CDATA[Reporte de jornadas y descanso de operadores]]></text></element>
        <element kind="textField" positionType="Float" x="0" y="66" width="782" height="18" fontSize="9.0" forecolor="#586B7E"><expression><![CDATA[$P{GENERADO}]]></expression></element>
        <element kind="textField" positionType="Float" x="0" y="88" width="782" height="34" textAdjust="StretchHeight"><expression><![CDATA[$P{FILTROS}]]></expression></element>
        <element kind="textField" positionType="Float" x="0" y="128" width="782" height="34" textAdjust="StretchHeight" bold="true" fontSize="10.0"><expression><![CDATA[$P{METRICAS}]]></expression></element>
        <element kind="staticText" positionType="Float" x="0" y="168" width="782" height="40" fontSize="8.0" forecolor="#586B7E"><text><![CDATA[Criterios: hay exceso de manejo cuando un tramo continuo (de iniciar o reanudar hasta la pausa o la entrega) supera las horas máximas del operador. El descanso es insuficiente cuando, por cada ciclo de manejo completado, no se acumularon las horas mínimas de descanso. Se aplica una tolerancia de 5 minutos. * Viaje con tramo o pausa abiertos: se calcula hasta la hora de generación.]]></text></element>
        <element kind="staticText" positionType="Float" removeLineWhenBlank="true" x="0" y="212" width="782" height="20" forecolor="#586B7E"><printWhenExpression><![CDATA[$P{VACIO}]]></printWhenExpression><text><![CDATA[No hay viajes con registros de jornada que coincidan con los filtros.]]></text></element>
    </title>
    <pageHeader height="20">
        <element kind="textField" x="0" y="0" width="782" height="16" textAdjust="StretchHeight" fontSize="8.0" forecolor="#586B7E"><printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression><expression><![CDATA[$P{EMPRESA} + " | Reporte de jornadas y descanso de operadores"]]></expression></element>
    </pageHeader>
    <columnHeader height="32">
        <element kind="staticText" x="0" y="0" width="45" height="32" style="Encabezado"><text><![CDATA[Viaje]]></text></element>
        <element kind="staticText" x="45" y="0" width="80" height="32" style="Encabezado"><text><![CDATA[Carga]]></text></element>
        <element kind="staticText" x="125" y="0" width="60" height="32" style="Encabezado"><text><![CDATA[Unidad]]></text></element>
        <element kind="staticText" x="185" y="0" width="85" height="32" style="Encabezado"><text><![CDATA[Inicio]]></text></element>
        <element kind="staticText" x="270" y="0" width="70" height="32" style="Encabezado"><text><![CDATA[Estado]]></text></element>
        <element kind="staticText" x="340" y="0" width="75" height="32" style="Encabezado"><text><![CDATA[Manejo total]]></text></element>
        <element kind="staticText" x="415" y="0" width="100" height="32" style="Encabezado"><text><![CDATA[Tramo continuo máx. (% del límite)]]></text></element>
        <element kind="staticText" x="515" y="0" width="107" height="32" style="Encabezado"><text><![CDATA[Descanso acumulado / requerido]]></text></element>
        <element kind="staticText" x="622" y="0" width="50" height="32" style="Encabezado"><text><![CDATA[Pausas]]></text></element>
        <element kind="staticText" x="672" y="0" width="110" height="32" style="Encabezado"><text><![CDATA[Resultado]]></text></element>
    </columnHeader>
    <detail>
        <band height="28" splitType="Prevent">
            <element kind="textField" x="0" y="0" width="45" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{viaje}]]></expression></element>
            <element kind="textField" x="45" y="0" width="80" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{carga}]]></expression></element>
            <element kind="textField" x="125" y="0" width="60" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{unidad}]]></expression></element>
            <element kind="textField" x="185" y="0" width="85" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{inicio}]]></expression></element>
            <element kind="textField" x="270" y="0" width="70" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{estado}]]></expression></element>
            <element kind="textField" x="340" y="0" width="75" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{manejo}]]></expression></element>
            <element kind="textField" x="415" y="0" width="100" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{tramo}]]></expression></element>
            <element kind="textField" x="515" y="0" width="107" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{descanso}]]></expression></element>
            <element kind="textField" x="622" y="0" width="50" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda"><expression><![CDATA[$F{pausas}]]></expression></element>
            <element kind="textField" x="672" y="0" width="110" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda" bold="true" forecolor="#B22222"><printWhenExpression><![CDATA[$F{incumple}]]></printWhenExpression><expression><![CDATA[$F{resultado}]]></expression></element>
            <element kind="textField" x="672" y="0" width="110" height="28" textAdjust="StretchHeight" stretchType="ContainerHeight" vTextAlign="Middle" style="Celda" forecolor="#1B7F3B"><printWhenExpression><![CDATA[!$F{incumple}]]></printWhenExpression><expression><![CDATA[$F{resultado}]]></expression></element>
        </band>
    </detail>
    <pageFooter height="25">
        <element kind="textField" x="0" y="8" width="640" height="16" fontSize="8.0" forecolor="#586B7E"><expression><![CDATA[$P{GENERADO}]]></expression></element>
        <element kind="textField" x="652" y="8" width="130" height="16" hTextAlign="Right" fontSize="8.0"><expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression></element>
    </pageFooter>
</jasperReport>
