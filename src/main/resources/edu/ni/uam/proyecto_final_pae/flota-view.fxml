<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.FlotaController"
            prefWidth="980" prefHeight="700">
    <stylesheets>
        <URL value="@styles/fleetroute.css"/>
    </stylesheets>
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="4">
            <Label text="Gestión de flota" styleClass="page-title"/>
            <Label fx:id="lblEstado" text="Listo." styleClass="status-label"/>
            <HBox spacing="8" styleClass="actions-bar">
                <Button fx:id="btnCargas" text="Cargas" styleClass="btn-secondary" onAction="#abrirCargas">
                    <graphic><FontIcon iconLiteral="fas-box-open"/></graphic>
                </Button>
                <Button fx:id="btnViajes" text="Viajes" styleClass="btn-secondary" onAction="#abrirViajes">
                    <graphic><FontIcon iconLiteral="fas-truck-moving"/></graphic>
                </Button>
                <Button fx:id="btnMonitor" text="Monitor" styleClass="btn-secondary" onAction="#abrirMonitor">
                    <graphic><FontIcon iconLiteral="fas-desktop"/></graphic>
                </Button>
            </HBox>
            <padding>
                <Insets bottom="10"/>
            </padding>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="Unidades">
                <BorderPane>
                    <center>
                        <VBox spacing="8">
                            <HBox spacing="8" styleClass="actions-bar">
                                <Button fx:id="btnVerUnidades" text="Ver todas"
                                        styleClass="btn-secondary" onAction="#verUnidades">
                                    <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                                </Button>
                                <Button fx:id="btnVerUnidadesDisponibles" text="Disponibles"
                                        styleClass="btn-secondary" onAction="#verUnidadesDisponibles">
                                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                                </Button>
                            </HBox>
                            <TableView fx:id="tablaUnidades" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNumeroUnidad" text="N.º unidad" prefWidth="110"/>
                                    <TableColumn fx:id="colPlacas" text="Placas" prefWidth="110"/>
                                    <TableColumn fx:id="colModelo" text="Modelo" prefWidth="160"/>
                                    <TableColumn fx:id="colCapacidad" text="Capacidad (t)" prefWidth="110"/>
                                    <TableColumn fx:id="colEstadoUnidad" text="Estado" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <VBox spacing="8" prefWidth="290" styleClass="form-pane">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="14"/>
                            </padding>
                            <Label text="N.º de unidad *"/>
                            <TextField fx:id="txtNumeroUnidad" promptText="U-001"/>
                            <Label text="Placas *"/>
                            <TextField fx:id="txtPlacas" promptText="M 000001"/>
                            <Label text="Modelo *"/>
                            <TextField fx:id="txtModelo"/>
                            <Label text="Capacidad en toneladas (opcional)"/>
                            <TextField fx:id="txtCapacidad" promptText="30.00"/>
                            <Label text="Estado *"/>
                            <ComboBox fx:id="cmbEstadoUnidad" maxWidth="Infinity"/>
                            <Separator/>
                            <Button fx:id="btnGuardarUnidad" text="Guardar nueva" maxWidth="Infinity"
                                    styleClass="btn-primary" onAction="#guardarUnidad">
                                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                            </Button>
                            <Button fx:id="btnActualizarUnidad" text="Actualizar seleccionada" maxWidth="Infinity"
                                    styleClass="btn-secondary" onAction="#actualizarUnidad">
                                <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
                            </Button>
                            <Button fx:id="btnEliminarUnidad" text="Eliminar seleccionada" maxWidth="Infinity"
                                    styleClass="btn-danger" onAction="#eliminarUnidad">
                                <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarUnidad" text="Limpiar formulario" maxWidth="Infinity"
                                    styleClass="btn-ghost" onAction="#limpiarUnidad">
                                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            </Button>
                        </VBox>
                    </right>
                </BorderPane>
            </Tab>

            <Tab text="Operadores">
                <BorderPane>
                    <center>
                        <VBox spacing="8">
                            <HBox spacing="8" styleClass="actions-bar">
                                <Button fx:id="btnVerOperadores" text="Ver todos"
                                        styleClass="btn-secondary" onAction="#verOperadores">
                                    <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                                </Button>
                                <Button fx:id="btnVerOperadoresDisponibles" text="Disponibles"
                                        styleClass="btn-secondary" onAction="#verOperadoresDisponibles">
                                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                                </Button>
                            </HBox>
                            <TableView fx:id="tablaOperadores" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colCedula" text="Cédula" prefWidth="130"/>
                                    <TableColumn fx:id="colNombreOperador" text="Nombre" prefWidth="180"/>
                                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110"/>
                                    <TableColumn fx:id="colHorasMax" text="Máx. conducción" prefWidth="120"/>
                                    <TableColumn fx:id="colHorasMin" text="Mín. descanso" prefWidth="110"/>
                                    <TableColumn fx:id="colEstadoOperador" text="Estado" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <VBox spacing="8" prefWidth="290" styleClass="form-pane">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="14"/>
                            </padding>
                            <Label text="Cédula *"/>
                            <TextField fx:id="txtCedula" promptText="001-000000-0001A"/>
                            <Label text="Nombre completo *"/>
                            <TextField fx:id="txtNombreOperador"/>
                            <Label text="Teléfono"/>
                            <TextField fx:id="txtTelefonoOperador"/>
                            <Label text="Horas máximas de conducción *"/>
                            <TextField fx:id="txtHorasMax" promptText="8.00"/>
                            <Label text="Horas mínimas de descanso *"/>
                            <TextField fx:id="txtHorasMin" promptText="8.00"/>
                            <Label text="Estado *"/>
                            <ComboBox fx:id="cmbEstadoOperador" maxWidth="Infinity"/>
                            <Separator/>
                            <Button fx:id="btnGuardarOperador" text="Guardar nuevo" maxWidth="Infinity"
                                    styleClass="btn-primary" onAction="#guardarOperador">
                                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                            </Button>
                            <Button fx:id="btnActualizarOperador" text="Actualizar seleccionado" maxWidth="Infinity"
                                    styleClass="btn-secondary" onAction="#actualizarOperador">
                                <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
                            </Button>
                            <Button fx:id="btnEliminarOperador" text="Eliminar seleccionado" maxWidth="Infinity"
                                    styleClass="btn-danger" onAction="#eliminarOperador">
                                <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarOperador" text="Limpiar formulario" maxWidth="Infinity"
                                    styleClass="btn-ghost" onAction="#limpiarOperador">
                                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            </Button>
                        </VBox>
                    </right>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
