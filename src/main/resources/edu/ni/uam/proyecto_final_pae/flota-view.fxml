<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.FlotaController"
            prefWidth="980" prefHeight="700">
    <stylesheets>
        <URL value="@styles/fleetroute.css"/>
    </stylesheets>
    <fx:define>
        <ToggleGroup fx:id="grupoUnidad"/>
        <ToggleGroup fx:id="grupoOperador"/>
        <ToggleGroup fx:id="grupoCliente"/>
    </fx:define>
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="4">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Gestión de flota" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnReporte" styleClass="icon-button" onAction="#abrirReporte">
                    <graphic><FontIcon iconLiteral="fas-chart-pie" iconSize="18"/></graphic>
                    <tooltip><Tooltip text="Reporte financiero"/></tooltip>
                </Button>
                <Button fx:id="btnPanelAdmin" styleClass="icon-button" onAction="#abrirPanelAdmin">
                    <graphic><FontIcon iconLiteral="fas-user-cog" iconSize="18"/></graphic>
                    <tooltip><Tooltip text="Panel administrativo"/></tooltip>
                </Button>
            </HBox>
            <Label fx:id="lblEmpresa" styleClass="status-label"/>
            <HBox spacing="8" styleClass="actions-bar">
                <Button fx:id="btnCargas" text="Cargas" styleClass="btn-secondary" onAction="#abrirCargas">
                    <graphic><FontIcon iconLiteral="fas-box-open"/></graphic>
                </Button>
                <Button fx:id="btnViajes" text="Viajes" styleClass="btn-secondary" onAction="#abrirViajes">
                    <graphic><FontIcon iconLiteral="fas-truck-moving"/></graphic>
                </Button>
                <Button fx:id="btnMonitor" text="Monitor" styleClass="btn-secondary" onAction="#abrirMonitor">
                    <graphic><FontIcon iconLiteral="fas-desktop"/></graphic>
                </Button>
                <Button fx:id="btnSalir" text="Cerrar sesión" styleClass="btn-ghost" onAction="#salir">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt"/></graphic>
                </Button>
            </HBox>
            <padding>
                <Insets bottom="10"/>
            </padding>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="Unidades">
                <BorderPane>
                    <center>
                        <VBox spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <TextField fx:id="txtFiltroUnidad" prefWidth="320" promptText="buscador">
                                    <tooltip>
                                        <Tooltip text="Busca por número de unidad, placas, modelo o capacidad."/>
                                    </tooltip>
                                </TextField>
                                <Button fx:id="btnLimpiarBusquedaUnidad" styleClass="btn-ghost"
                                        onAction="#limpiarBusquedaUnidad">
                                    <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                                    <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
                                </Button>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="actions-bar">
                                <Label text="Filtrar por" styleClass="field-label"/>
                                <ToggleButton fx:id="btnUnidadTodos" text="Todas" selected="true"
                                              toggleGroup="$grupoUnidad" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnUnidadDisponible" text="Disponibles"
                                              toggleGroup="$grupoUnidad" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnUnidadRuta" text="En ruta"
                                              toggleGroup="$grupoUnidad" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-truck-moving"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnUnidadMantenimiento" text="Mantenimiento"
                                              toggleGroup="$grupoUnidad" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-tools"/></graphic>
                                </ToggleButton>
                            </HBox>
                            <Label fx:id="lblEstadoUnidades" text="Mostrando las unidades registradas."
                                   styleClass="status-label"/>
                            <TableView fx:id="tablaUnidades" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNumeroUnidad" text="N.º unidad" prefWidth="110"/>
                                    <TableColumn fx:id="colPlacas" text="Placas" prefWidth="110"/>
                                    <TableColumn fx:id="colModelo" text="Modelo" prefWidth="160"/>
                                    <TableColumn fx:id="colCapacidad" text="Capacidad (t)" prefWidth="110"/>
                                    <TableColumn fx:id="colEstadoUnidad" text="Estado" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <VBox spacing="8" prefWidth="290" styleClass="form-pane">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="14"/>
                            </padding>
                            <Label text="N.º de unidad *"/>
                            <TextField fx:id="txtNumeroUnidad" promptText="U-001"/>
                            <Label text="Placas *"/>
                            <TextField fx:id="txtPlacas" promptText="M 000001"/>
                            <Label text="Modelo *"/>
                            <TextField fx:id="txtModelo"/>
                            <Label text="Capacidad en toneladas (opcional)"/>
                            <TextField fx:id="txtCapacidad" promptText="30.00"/>
                            <Label text="Estado *"/>
                            <ComboBox fx:id="cmbEstadoUnidad" maxWidth="Infinity"/>
                            <Separator/>
                            <Button fx:id="btnGuardarUnidad" text="Guardar nueva" maxWidth="Infinity"
                                    styleClass="btn-primary" onAction="#guardarUnidad">
                                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                            </Button>
                            <Button fx:id="btnActualizarUnidad" text="Actualizar seleccionada" maxWidth="Infinity"
                                    styleClass="btn-secondary" onAction="#actualizarUnidad">
                                <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
                            </Button>
                            <Button fx:id="btnEliminarUnidad" text="Eliminar seleccionada" maxWidth="Infinity"
                                    styleClass="btn-danger" onAction="#eliminarUnidad">
                                <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarUnidad" text="Limpiar formulario" maxWidth="Infinity"
                                    styleClass="btn-ghost" onAction="#limpiarUnidad">
                                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            </Button>
                        </VBox>
                    </right>
                </BorderPane>
            </Tab>

            <Tab text="Operadores">
                <BorderPane>
                    <center>
                        <VBox spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <TextField fx:id="txtFiltroOperador" prefWidth="320" promptText="buscador">
                                    <tooltip>
                                        <Tooltip text="Busca por nombre, cédula o teléfono del operador."/>
                                    </tooltip>
                                </TextField>
                                <Button fx:id="btnLimpiarBusquedaOperador" styleClass="btn-ghost"
                                        onAction="#limpiarBusquedaOperador">
                                    <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                                    <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
                                </Button>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="actions-bar">
                                <Label text="Filtrar por" styleClass="field-label"/>
                                <ToggleButton fx:id="btnOperadorTodos" text="Todos" selected="true"
                                              toggleGroup="$grupoOperador" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorDisponible" text="Disponibles"
                                              toggleGroup="$grupoOperador" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorRuta" text="En ruta"
                                              toggleGroup="$grupoOperador" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-truck-moving"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorDescanso" text="Descanso"
                                              toggleGroup="$grupoOperador" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-bed"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorInactivo" text="Inactivos"
                                              toggleGroup="$grupoOperador" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-user-slash"/></graphic>
                                </ToggleButton>
                            </HBox>
                            <Label fx:id="lblEstadoOperadores" text="Mostrando los operadores registrados."
                                   styleClass="status-label"/>
                            <TableView fx:id="tablaOperadores" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colCedula" text="Cédula" prefWidth="130"/>
                                    <TableColumn fx:id="colNombreOperador" text="Nombre" prefWidth="180"/>
                                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110"/>
                                    <TableColumn fx:id="colHorasMax" text="Máx. conducción" prefWidth="120"/>
                                    <TableColumn fx:id="colHorasMin" text="Mín. descanso" prefWidth="110"/>
                                    <TableColumn fx:id="colEstadoOperador" text="Estado" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <VBox spacing="8" prefWidth="290" styleClass="form-pane">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="14"/>
                            </padding>
                            <Label text="Cédula *"/>
                            <TextField fx:id="txtCedula" promptText="001-000000-0001A"/>
                            <Label text="Nombre completo *"/>
                            <TextField fx:id="txtNombreOperador"/>
                            <Label text="Teléfono"/>
                            <TextField fx:id="txtTelefonoOperador"/>
                            <Label text="Horas máximas de conducción *"/>
                            <TextField fx:id="txtHorasMax" promptText="8.00"/>
                            <Label text="Horas mínimas de descanso *"/>
                            <TextField fx:id="txtHorasMin" promptText="8.00"/>
                            <Label text="Estado *"/>
                            <ComboBox fx:id="cmbEstadoOperador" maxWidth="Infinity"/>
                            <Separator/>
                            <Button fx:id="btnGuardarOperador" text="Guardar nuevo" maxWidth="Infinity"
                                    styleClass="btn-primary" onAction="#guardarOperador">
                                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                            </Button>
                            <Button fx:id="btnActualizarOperador" text="Actualizar seleccionado" maxWidth="Infinity"
                                    styleClass="btn-secondary" onAction="#actualizarOperador">
                                <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
                            </Button>
                            <Button fx:id="btnEliminarOperador" text="Eliminar seleccionado" maxWidth="Infinity"
                                    styleClass="btn-danger" onAction="#eliminarOperador">
                                <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarOperador" text="Limpiar formulario" maxWidth="Infinity"
                                    styleClass="btn-ghost" onAction="#limpiarOperador">
                                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            </Button>
                        </VBox>
                    </right>
                </BorderPane>
            </Tab>

            <Tab text="Clientes">
                <BorderPane>
                    <center>
                        <VBox spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <TextField fx:id="txtFiltroCliente" prefWidth="320" promptText="buscador">
                                    <tooltip>
                                        <Tooltip text="Busca por empresa, contacto, teléfono o email."/>
                                    </tooltip>
                                </TextField>
                                <Button fx:id="btnLimpiarBusquedaCliente" styleClass="btn-ghost"
                                        onAction="#limpiarBusquedaCliente">
                                    <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                                    <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
                                </Button>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="actions-bar">
                                <Label text="Filtrar por" styleClass="field-label"/>
                                <ToggleButton fx:id="btnClienteTodos" text="Todos" selected="true"
                                              toggleGroup="$grupoCliente" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnClienteActivos" text="Activos"
                                              toggleGroup="$grupoCliente" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnClienteInactivos" text="Inactivos"
                                              toggleGroup="$grupoCliente" styleClass="filter-toggle">
                                    <graphic><FontIcon iconLiteral="fas-user-slash"/></graphic>
                                </ToggleButton>
                            </HBox>
                            <Label fx:id="lblEstadoClientes" text="Mostrando los clientes registrados."
                                   styleClass="status-label"/>
                            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNombreCliente" text="Empresa" prefWidth="150"/>
                                    <TableColumn fx:id="colContactoCliente" text="Contacto" prefWidth="110"/>
                                    <TableColumn fx:id="colTelefonoCliente" text="Teléfono" prefWidth="90"/>
                                    <TableColumn fx:id="colEmailCliente" text="Email" prefWidth="140"/>
                                    <TableColumn fx:id="colDireccionCliente" text="Dirección" prefWidth="140"/>
                                    <TableColumn fx:id="colActivoCliente" text="Activo" prefWidth="60"/>
                                    <TableColumn fx:id="colRegistroCliente" text="Registro" prefWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <VBox spacing="8" prefWidth="290" styleClass="form-pane">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="14"/>
                            </padding>
                            <Label text="Nombre de la empresa *"/>
                            <TextField fx:id="txtNombreCliente" promptText="Cliente S.A."/>
                            <Label text="Contacto"/>
                            <TextField fx:id="txtContactoCliente" promptText="Persona de contacto"/>
                            <Label text="Teléfono"/>
                            <TextField fx:id="txtTelefonoCliente" promptText="2222-2222"/>
                            <Label text="Email"/>
                            <TextField fx:id="txtEmailCliente" promptText="cliente@empresa.com"/>
                            <Label text="Dirección"/>
                            <TextField fx:id="txtDireccionCliente" promptText="Dirección del cliente"/>
                            <CheckBox fx:id="chkActivoCliente" text="Cliente activo" selected="true"/>
                            <Separator/>
                            <Button fx:id="btnGuardarCliente" text="Guardar nuevo" maxWidth="Infinity"
                                    styleClass="btn-primary" onAction="#guardarCliente">
                                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                            </Button>
                            <Button fx:id="btnActualizarCliente" text="Actualizar seleccionado" maxWidth="Infinity"
                                    styleClass="btn-secondary" onAction="#actualizarCliente">
                                <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
                            </Button>
                            <Button fx:id="btnEliminarCliente" text="Eliminar seleccionado" maxWidth="Infinity"
                                    styleClass="btn-danger" onAction="#eliminarCliente">
                                <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarCliente" text="Limpiar formulario" maxWidth="Infinity"
                                    styleClass="btn-ghost" onAction="#limpiarCliente">
                                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            </Button>
                        </VBox>
                    </right>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
