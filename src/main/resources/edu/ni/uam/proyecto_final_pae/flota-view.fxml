<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane prefHeight="700" prefWidth="980" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ni.uam.proyecto_final_pae.controller.FlotaController">
    <stylesheets>
        <URL value="@styles/fleetroute.css" />
    </stylesheets>
    <fx:define>
        <ToggleGroup fx:id="grupoUnidad" />
        <ToggleGroup fx:id="grupoOperador" />
        <ToggleGroup fx:id="grupoCliente" />
    </fx:define>
    <padding>
        <Insets bottom="14" left="14" right="14" top="14" />
    </padding>

    <top>
        <VBox spacing="4">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="page-title" text="Gestión de flota" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRefrescarFlota" managed="false" onAction="#refrescarFlota" styleClass="icon-button" visible="false">
                    <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="18" /></graphic>
                    <tooltip><Tooltip text="Reintentar la actualización automática de flota." /></tooltip>
                </Button>
                <Button fx:id="btnReporte" onAction="#abrirReporte" styleClass="icon-button">
                    <graphic><FontIcon iconLiteral="fas-chart-pie" iconSize="18" /></graphic>
                    <tooltip><Tooltip text="Reportes" /></tooltip>
                </Button>
                <Button fx:id="btnPanelAdmin" onAction="#abrirPanelAdmin" styleClass="icon-button">
                    <graphic><FontIcon iconLiteral="fas-user-cog" iconSize="18" /></graphic>
                    <tooltip><Tooltip text="Panel administrativo" /></tooltip>
                </Button>
            </HBox>
            <Label fx:id="lblEmpresa" styleClass="status-label" />
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="actions-bar">
                <Button fx:id="btnCargas" onAction="#abrirCargas" styleClass="btn-secondary" text="Cargas">
                    <graphic><FontIcon iconLiteral="fas-box-open" /></graphic>
                </Button>
                <Button fx:id="btnViajes" onAction="#abrirViajes" styleClass="btn-secondary" text="Viajes">
                    <graphic><FontIcon iconLiteral="fas-truck-moving" /></graphic>
                </Button>
                <Button fx:id="btnMonitor" onAction="#abrirMonitor" styleClass="btn-secondary" text="Monitor">
                    <graphic><FontIcon iconLiteral="fas-desktop" /></graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane alignment="TOP_LEFT">
               <VBox>
                  <children>
                          <Button fx:id="btnConexion" maxWidth="150" minWidth="150" onAction="#alternarConexion" prefWidth="150" styleClass="btn-secondary" text="Iniciar Conexión" />
                  </children>
               </VBox>
                    <Circle fx:id="circuloConexion" fill="#B42318" mouseTransparent="true" radius="4" translateX="5" translateY="5" StackPane.alignment="TOP_LEFT" />
                </StackPane>
                <Button fx:id="btnEnlaceTunel" onAction="#copiarEnlaceTunel" styleClass="tunnel-link-button">
                    <graphic><FontIcon fx:id="iconoEnlaceTunel" iconLiteral="fas-unlink" iconSize="16" /></graphic>
                    <tooltip><Tooltip text="Sin enlace activo." /></tooltip>
                </Button>
                <Button fx:id="btnSalir" onAction="#salir" styleClass="btn-ghost" text="Cerrar sesión">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt" /></graphic>
                </Button>
            </HBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="0.0" prefWidth="952.0">
                <Region prefWidth="884.0" HBox.hgrow="ALWAYS" />
            </HBox>
            <padding>
                <Insets bottom="10" />
            </padding>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">

            <Tab text="Unidades">
                <BorderPane>
                    <center>
                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <TextField fx:id="txtFiltroUnidad" prefWidth="320" promptText="buscador">
                                    <tooltip>
                                        <Tooltip text="Busca por número de unidad, placas, modelo o capacidad." />
                                    </tooltip>
                                </TextField>
                                <Button fx:id="btnLimpiarBusquedaUnidad" onAction="#limpiarBusquedaUnidad" styleClass="btn-ghost">
                                    <graphic><FontIcon iconLiteral="fas-eraser" /></graphic>
                                    <tooltip><Tooltip text="Limpiar búsqueda" /></tooltip>
                                </Button>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="actions-bar">
                                <Label styleClass="field-label" text="Filtrar por" />
                                <ToggleButton fx:id="btnUnidadTodos" selected="true" styleClass="filter-toggle" text="Todas">
                                    <graphic><FontIcon iconLiteral="fas-list" /></graphic>
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoUnidad" />
                           </toggleGroup>
                                </ToggleButton>
                                <ToggleButton fx:id="btnUnidadDisponible" styleClass="filter-toggle" text="Disponibles" toggleGroup="$grupoUnidad">
                                    <graphic><FontIcon iconLiteral="fas-check-circle" /></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnUnidadRuta" styleClass="filter-toggle" text="En ruta" toggleGroup="$grupoUnidad">
                                    <graphic><FontIcon iconLiteral="fas-truck-moving" /></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnUnidadMantenimiento" styleClass="filter-toggle" text="Mantenimiento" toggleGroup="$grupoUnidad">
                                    <graphic><FontIcon iconLiteral="fas-tools" /></graphic>
                                </ToggleButton>
                            </HBox>
                            <Label fx:id="lblEstadoUnidades" styleClass="status-label" text="Mostrando las unidades registradas." />
                            <TableView fx:id="tablaUnidades" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNumeroUnidad" prefWidth="110" text="N.º unidad" />
                                    <TableColumn fx:id="colPlacas" prefWidth="110" text="Placas" />
                                    <TableColumn fx:id="colModelo" prefWidth="160" text="Modelo" />
                                    <TableColumn fx:id="colCapacidad" prefWidth="110" text="Capacidad (t)" />
                                    <TableColumn fx:id="colEstadoUnidad" prefWidth="120" text="Estado" />
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="306" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
                            <content>
                        <VBox prefWidth="290" spacing="8" styleClass="form-pane">
                            <padding>
                                <Insets bottom="12" left="14" right="12" top="12" />
                            </padding>
                            <Label text="N.º de unidad *" />
                            <TextField fx:id="txtNumeroUnidad" promptText="U-001" />
                            <Label text="Placas *" />
                            <TextField fx:id="txtPlacas" promptText="M 000001" />
                            <Label text="Modelo *" />
                            <TextField fx:id="txtModelo" />
                            <Label text="Capacidad en toneladas (opcional)" />
                            <TextField fx:id="txtCapacidad" promptText="30.00" />
                            <Label text="Estado *" />
                            <ComboBox fx:id="cmbEstadoUnidad" maxWidth="Infinity" promptText="Seleccione estado" />
                            <Separator />
                            <Button fx:id="btnGuardarUnidad" maxWidth="Infinity" onAction="#guardarUnidad" styleClass="btn-primary" text="Guardar nueva">
                                <graphic><FontIcon iconLiteral="fas-plus" /></graphic>
                            </Button>
                            <Button fx:id="btnActualizarUnidad" maxWidth="Infinity" onAction="#actualizarUnidad" styleClass="btn-secondary" text="Actualizar seleccionada">
                                <graphic><FontIcon iconLiteral="fas-edit" /></graphic>
                            </Button>
                            <Button fx:id="btnEliminarUnidad" maxWidth="Infinity" onAction="#eliminarUnidad" styleClass="btn-danger" text="Eliminar seleccionada">
                                <graphic><FontIcon iconLiteral="fas-trash-alt" /></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarUnidad" maxWidth="Infinity" onAction="#limpiarUnidad" styleClass="btn-ghost" text="Limpiar formulario">
                                <graphic><FontIcon iconLiteral="fas-eraser" /></graphic>
                            </Button>
                        </VBox>
                            </content>
                        </ScrollPane>
                    </right>
                </BorderPane>
            </Tab>

            <Tab text="Operadores">
                <BorderPane>
                    <center>
                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <TextField fx:id="txtFiltroOperador" prefWidth="320" promptText="buscador">
                                    <tooltip>
                                        <Tooltip text="Busca por nombre, cédula o teléfono del operador." />
                                    </tooltip>
                                </TextField>
                                <Button fx:id="btnLimpiarBusquedaOperador" onAction="#limpiarBusquedaOperador" styleClass="btn-ghost">
                                    <graphic><FontIcon iconLiteral="fas-eraser" /></graphic>
                                    <tooltip><Tooltip text="Limpiar búsqueda" /></tooltip>
                                </Button>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="actions-bar">
                                <Label styleClass="field-label" text="Filtrar por" />
                                <ToggleButton fx:id="btnOperadorTodos" selected="true" styleClass="filter-toggle" text="Todos">
                                    <graphic><FontIcon iconLiteral="fas-list" /></graphic>
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoOperador" />
                           </toggleGroup>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorDisponible" styleClass="filter-toggle" text="Disponibles" toggleGroup="$grupoOperador">
                                    <graphic><FontIcon iconLiteral="fas-check-circle" /></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorRuta" styleClass="filter-toggle" text="En ruta" toggleGroup="$grupoOperador">
                                    <graphic><FontIcon iconLiteral="fas-truck-moving" /></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorDescanso" styleClass="filter-toggle" text="Descanso" toggleGroup="$grupoOperador">
                                    <graphic><FontIcon iconLiteral="fas-bed" /></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnOperadorInactivo" styleClass="filter-toggle" text="Inactivos" toggleGroup="$grupoOperador">
                                    <graphic><FontIcon iconLiteral="fas-user-slash" /></graphic>
                                </ToggleButton>
                            </HBox>
                            <Label fx:id="lblEstadoOperadores" styleClass="status-label" text="Mostrando los operadores registrados." />
                            <TableView fx:id="tablaOperadores" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colCedula" prefWidth="120" text="Cédula" />
                                    <TableColumn fx:id="colNombreOperador" prefWidth="135" text="Nombre" />
                                    <TableColumn fx:id="colTelefono" prefWidth="85" text="Teléfono" />
                                    <TableColumn fx:id="colHorasMax" prefWidth="145" text="Máx. conducción (horas)" />
                                    <TableColumn fx:id="colHorasMin" prefWidth="135" text="Mín. descanso (horas)" />
                                    <TableColumn fx:id="colEstadoOperador" prefWidth="90" text="Estado" />
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="296" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
                            <content>
                        <VBox prefWidth="280" spacing="8" styleClass="form-pane">
                            <padding>
                                <Insets bottom="12" left="14" right="12" top="12" />
                            </padding>
                            <Label text="Cédula *" />
                            <TextField fx:id="txtCedula" promptText="001-000000-0001A" />
                            <Label text="Nombre completo *" />
                            <TextField fx:id="txtNombreOperador" />
                            <Label text="Teléfono" />
                            <TextField fx:id="txtTelefonoOperador" />
                            <Label text="Horas máximas de conducción *" />
                            <TextField fx:id="txtHorasMax" promptText="8.00" />
                            <Label text="Horas mínimas de descanso *" />
                            <TextField fx:id="txtHorasMin" promptText="8.00" />
                            <Label text="Estado *" />
                            <ComboBox fx:id="cmbEstadoOperador" maxWidth="Infinity" promptText="Seleccione estado" />
                            <Separator />
                            <Button fx:id="btnGuardarOperador" maxWidth="Infinity" onAction="#guardarOperador" styleClass="btn-primary" text="Guardar nuevo">
                                <graphic><FontIcon iconLiteral="fas-plus" /></graphic>
                            </Button>
                            <Button fx:id="btnActualizarOperador" maxWidth="Infinity" onAction="#actualizarOperador" styleClass="btn-secondary" text="Actualizar seleccionado">
                                <graphic><FontIcon iconLiteral="fas-edit" /></graphic>
                            </Button>
                            <Button fx:id="btnEliminarOperador" maxWidth="Infinity" onAction="#eliminarOperador" styleClass="btn-danger" text="Eliminar seleccionado">
                                <graphic><FontIcon iconLiteral="fas-trash-alt" /></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarOperador" maxWidth="Infinity" onAction="#limpiarOperador" styleClass="btn-ghost" text="Limpiar formulario">
                                <graphic><FontIcon iconLiteral="fas-eraser" /></graphic>
                            </Button>
                        </VBox>
                            </content>
                        </ScrollPane>
                    </right>
                </BorderPane>
            </Tab>

            <Tab text="Clientes">
                <BorderPane>
                    <center>
                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <TextField fx:id="txtFiltroCliente" prefWidth="320" promptText="buscador">
                                    <tooltip>
                                        <Tooltip text="Busca por empresa, contacto, teléfono o email." />
                                    </tooltip>
                                </TextField>
                                <Button fx:id="btnLimpiarBusquedaCliente" onAction="#limpiarBusquedaCliente" styleClass="btn-ghost">
                                    <graphic><FontIcon iconLiteral="fas-eraser" /></graphic>
                                    <tooltip><Tooltip text="Limpiar búsqueda" /></tooltip>
                                </Button>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="actions-bar">
                                <Label styleClass="field-label" text="Filtrar por" />
                                <ToggleButton fx:id="btnClienteTodos" selected="true" styleClass="filter-toggle" text="Todos">
                                    <graphic><FontIcon iconLiteral="fas-list" /></graphic>
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoCliente" />
                           </toggleGroup>
                                </ToggleButton>
                                <ToggleButton fx:id="btnClienteActivos" styleClass="filter-toggle" text="Activos" toggleGroup="$grupoCliente">
                                    <graphic><FontIcon iconLiteral="fas-check-circle" /></graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btnClienteInactivos" styleClass="filter-toggle" text="Inactivos" toggleGroup="$grupoCliente">
                                    <graphic><FontIcon iconLiteral="fas-user-slash" /></graphic>
                                </ToggleButton>
                            </HBox>
                            <Label fx:id="lblEstadoClientes" styleClass="status-label" text="Mostrando los clientes registrados." />
                            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNombreCliente" prefWidth="150" text="Empresa" />
                                    <TableColumn fx:id="colContactoCliente" prefWidth="110" text="Contacto" />
                                    <TableColumn fx:id="colTelefonoCliente" prefWidth="90" text="Teléfono" />
                                    <TableColumn fx:id="colEmailCliente" prefWidth="140" text="Email" />
                                    <TableColumn fx:id="colDireccionCliente" prefWidth="140" text="Dirección" />
                                    <TableColumn fx:id="colActivoCliente" prefWidth="60" text="Activo" />
                                    <TableColumn fx:id="colRegistroCliente" prefWidth="110" text="Registro" />
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                    <right>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="306" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
                            <content>
                        <VBox prefWidth="290" spacing="8" styleClass="form-pane">
                            <padding>
                                <Insets bottom="12" left="14" right="12" top="12" />
                            </padding>
                            <Label text="Nombre de la empresa *" />
                            <TextField fx:id="txtNombreCliente" promptText="Cliente S.A." />
                            <Label text="Contacto" />
                            <TextField fx:id="txtContactoCliente" promptText="Persona de contacto" />
                            <Label text="Teléfono" />
                            <TextField fx:id="txtTelefonoCliente" promptText="2222-2222" />
                            <Label text="Email" />
                            <TextField fx:id="txtEmailCliente" promptText="cliente@empresa.com" />
                            <Label text="Dirección" />
                            <TextField fx:id="txtDireccionCliente" promptText="Dirección del cliente" />
                            <CheckBox fx:id="chkActivoCliente" selected="true" text="Cliente activo" />
                            <Separator />
                            <Button fx:id="btnGuardarCliente" maxWidth="Infinity" onAction="#guardarCliente" styleClass="btn-primary" text="Guardar nuevo">
                                <graphic><FontIcon iconLiteral="fas-plus" /></graphic>
                            </Button>
                            <Button fx:id="btnActualizarCliente" maxWidth="Infinity" onAction="#actualizarCliente" styleClass="btn-secondary" text="Actualizar seleccionado">
                                <graphic><FontIcon iconLiteral="fas-edit" /></graphic>
                            </Button>
                            <Button fx:id="btnEliminarCliente" maxWidth="Infinity" onAction="#eliminarCliente" styleClass="btn-danger" text="Eliminar seleccionado">
                                <graphic><FontIcon iconLiteral="fas-trash-alt" /></graphic>
                            </Button>
                            <Button fx:id="btnLimpiarCliente" maxWidth="Infinity" onAction="#limpiarCliente" styleClass="btn-ghost" text="Limpiar formulario">
                                <graphic><FontIcon iconLiteral="fas-eraser" /></graphic>
                            </Button>
                        </VBox>
                            </content>
                        </ScrollPane>
                    </right>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
