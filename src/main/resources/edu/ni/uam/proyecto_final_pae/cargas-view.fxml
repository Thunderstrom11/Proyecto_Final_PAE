<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.CargaController"
            prefWidth="980" prefHeight="700">
    <stylesheets>
        <URL value="@styles/fleetroute.css"/>
    </stylesheets>
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="4">
            <Label text="Gestión de cargas" styleClass="page-title"/>
            <Label fx:id="lblEstado" text="Listo." styleClass="status-label"/>
            <padding>
                <Insets bottom="10"/>
            </padding>
        </VBox>
    </top>

    <center>
        <VBox spacing="8">
            <FlowPane hgap="6" vgap="4" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscarCarga" promptText="buscador" prefWidth="190" prefHeight="34">
                    <tooltip>
                        <Tooltip text="Busca por número de carga, descripción o cliente."/>
                    </tooltip>
                </TextField>
                <DatePicker fx:id="dpFiltroDesde" promptText="Desde" prefWidth="120" prefHeight="34"/>
                <DatePicker fx:id="dpFiltroHasta" promptText="Hasta" prefWidth="120" prefHeight="34"/>
                <TextField fx:id="txtPesoMin" promptText="Peso mín." prefWidth="90" prefHeight="34"/>
                <TextField fx:id="txtPesoMax" promptText="Peso máx." prefWidth="90" prefHeight="34"/>
                <Button fx:id="btnLimpiarFiltros" styleClass="btn-ghost" onAction="#limpiarFiltros">
                    <tooltip><Tooltip text="Limpiar filtros"/></tooltip>
                    <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                </Button>
            </FlowPane>
            <HBox spacing="8" styleClass="actions-bar">
                <Label text="Filtrar por" styleClass="field-label"/>
                <Button fx:id="btnVerTodas" text="Ver todas"
                        styleClass="btn-secondary" onAction="#verTodas">
                    <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                </Button>
                <Button fx:id="btnVerPendientes" text="Pendientes"
                        styleClass="btn-secondary" onAction="#verPendientes">
                    <graphic><FontIcon iconLiteral="fas-clock"/></graphic>
                </Button>
                <Button fx:id="btnEntregadas" text="Entregadas"
                        styleClass="btn-secondary" onAction="#verEntregadas">
                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                </Button>
                <Button fx:id="btnEnTransito" text="En tránsito"
                        styleClass="btn-secondary" onAction="#verEnTransito">
                    <graphic><FontIcon iconLiteral="fas-truck-moving"/></graphic>
                </Button>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumero" text="N.º carga" prefWidth="95"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="150"/>
                    <TableColumn fx:id="colPeso" text="Peso (t)" prefWidth="65"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="115"/>
                    <TableColumn fx:id="colLimite" text="Fecha límite" prefWidth="135"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="85"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="8" prefWidth="280" styleClass="form-pane">
            <padding>
                <Insets top="12" right="12" bottom="12" left="14"/>
            </padding>
            <Label text="N.º de carga *"/>
            <TextField fx:id="txtNumero" promptText="C-001"/>
            <Label text="Descripción"/>
            <TextField fx:id="txtDescripcion"/>
            <Label text="Peso en toneladas *"/>
            <TextField fx:id="txtPeso" promptText="12.50"/>
            <Label text="Cliente (opcional)"/>
            <HBox spacing="6">
                <ComboBox fx:id="cmbCliente" prefWidth="190"/>
                <Button fx:id="btnNuevoCliente" styleClass="btn-secondary" onAction="#nuevoCliente">
                    <tooltip><Tooltip text="Crear cliente"/></tooltip>
                    <graphic><FontIcon iconLiteral="fas-user-plus"/></graphic>
                </Button>
            </HBox>
            <Label text="Fecha límite *"/>
            <DatePicker fx:id="dpFecha"/>
            <Label text="Hora límite (HH:mm)"/>
            <TextField fx:id="txtHora" text="17:00"/>
            <Separator/>
            <Button fx:id="btnGuardar" text="Guardar" maxWidth="Infinity"
                    styleClass="btn-primary" onAction="#guardar">
                <graphic><FontIcon iconLiteral="fas-save"/></graphic>
            </Button>
            <Button fx:id="btnActualizar" text="Actualizar" maxWidth="Infinity"
                    styleClass="btn-secondary" onAction="#actualizar">
                <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
            </Button>
            <Button fx:id="btnEliminar" text="Eliminar" maxWidth="Infinity"
                    styleClass="btn-danger" onAction="#eliminar">
                <graphic><FontIcon iconLiteral="fas-trash-alt"/></graphic>
            </Button>
            <Button fx:id="btnLimpiar" text="Limpiar" maxWidth="Infinity"
                    styleClass="btn-ghost" onAction="#limpiar">
                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
            </Button>
        </VBox>
    </right>
</BorderPane>
