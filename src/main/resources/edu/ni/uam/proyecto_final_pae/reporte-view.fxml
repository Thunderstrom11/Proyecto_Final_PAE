<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.embed.swing.SwingNode?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.ReporteController" prefWidth="1120" prefHeight="820">
    <stylesheets><URL value="@styles/fleetroute.css"/></stylesheets>
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
    <top>
        <VBox spacing="10">
            <Label text="Reportes" styleClass="page-title"/>
            <VBox fx:id="panelFiltros" spacing="8">
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                    <Label text="Reporte" labelFor="$cmbTipo"/>
                    <ComboBox fx:id="cmbTipo" prefWidth="265" accessibleText="Tipo de reporte"/>
                    <Label text="Gráfico" labelFor="$cmbGrafico"/>
                    <ComboBox fx:id="cmbGrafico" prefWidth="180" accessibleText="Tipo de gráfico"/>
                    <Label fx:id="lblAgrupacion" text="Agrupación" labelFor="$cmbAgrupacion"/>
                    <ComboBox fx:id="cmbAgrupacion" prefWidth="165" accessibleText="Agrupación temporal"/>
                </FlowPane>
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkFiltrarFechas" text="Filtrar por fecha de creación"/>
                    <Label fx:id="lblDesde" text="Finalización: desde" labelFor="$dpDesde"/>
                    <DatePicker fx:id="dpDesde" prefWidth="140" accessibleText="Fecha desde"/>
                    <Label text="hasta" labelFor="$dpHasta"/>
                    <DatePicker fx:id="dpHasta" prefWidth="140" accessibleText="Fecha hasta"/>
                    <Button fx:id="btnMesActual" text="Mes actual" styleClass="btn-ghost" onAction="#mesActual"/>
                    <Button fx:id="btnMesAnterior" text="Mes anterior" styleClass="btn-ghost" onAction="#mesAnterior"/>
                </FlowPane>
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                    <Label text="Operador" labelFor="$cmbOperador"/>
                    <ComboBox fx:id="cmbOperador" prefWidth="220" accessibleText="Filtrar por operador"/>
                    <Label text="Unidad" labelFor="$cmbUnidad"/>
                    <ComboBox fx:id="cmbUnidad" prefWidth="155" accessibleText="Filtrar por unidad"/>
                    <Label text="Cliente" labelFor="$cmbCliente"/>
                    <ComboBox fx:id="cmbCliente" prefWidth="230" accessibleText="Filtrar por cliente"/>
                </FlowPane>
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                    <Label text="Estado" labelFor="$cmbEstado"/>
                    <ComboBox fx:id="cmbEstado" prefWidth="180" accessibleText="Estado de los viajes"/>
                    <Label fx:id="lblCarga" text="Carga" labelFor="$txtCarga"/>
                    <TextField fx:id="txtCarga" prefWidth="180" promptText="Número exacto" accessibleText="Número exacto de carga"/>
                </FlowPane>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnGenerar" text="Generar vista previa" styleClass="btn-primary" onAction="#generar"><graphic><FontIcon iconLiteral="fas-chart-bar"/></graphic></Button>
                <ProgressIndicator fx:id="progreso" prefWidth="24" prefHeight="24" visible="false" managed="false"/>
                <Label fx:id="lblTotales" wrapText="true" style="-fx-font-weight: bold;"/>
            </HBox>
            <Label fx:id="lblEstado" wrapText="true" styleClass="status-label"/>
            <padding><Insets bottom="10"/></padding>
        </VBox>
    </top>
    <center>
        <StackPane minWidth="0" minHeight="0" style="-fx-background-color: #e7ecf2;">
            <SwingNode fx:id="visorJasper" visible="false" focusTraversable="true" accessibleText="Visor nativo de JasperReports"/>
            <Label fx:id="lblSinPrevia" text="Seleccione un reporte y genere la vista previa." styleClass="status-label"/>
        </StackPane>
    </center>
</BorderPane>
