<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.CabinaController"
            styleClass="cabina-root"
            prefWidth="1180" prefHeight="760">
    <stylesheets>
        <URL value="@styles/fleetroute.css"/>
    </stylesheets>
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="8">
            <Label text="Cabina del operador" styleClass="page-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="actions-bar">
                <Label text="Operador:"/>
                <Label fx:id="lblOperadorSesion" text="—" styleClass="field-label"/>
                <Button fx:id="btnActualizar" text="Reintentar" styleClass="btn-secondary"
                        onAction="#refrescar" visible="false" managed="false">
                    <graphic><FontIcon iconLiteral="fas-sync-alt"/></graphic>
                    <tooltip><Tooltip text="Volver a intentar la actualización automática."/></tooltip>
                </Button>
                <Label fx:id="lblEstado" text="Cabina lista." styleClass="status-label"/>
                <Label fx:id="lblActualizado" text="" styleClass="status-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAlerta" text="Alerta" styleClass="btn-alert" onAction="#enviarAlerta">
                    <graphic><FontIcon iconLiteral="fas-exclamation-triangle"/></graphic>
                    <tooltip><Tooltip text="Enviar una alerta a los administradores con la ubicación y el viaje actual."/></tooltip>
                </Button>
                <Button fx:id="btnClave" text="Cambiar contraseña" styleClass="btn-ghost" onAction="#cambiarClave">
                    <graphic><FontIcon iconLiteral="fas-key"/></graphic>
                </Button>
                <Button fx:id="btnSalir" text="Cerrar sesión" styleClass="btn-ghost" onAction="#salir">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt"/></graphic>
                </Button>
            </HBox>
            <padding>
                <Insets bottom="10"/>
            </padding>
        </VBox>
    </top>

    <center>
        <HBox spacing="12" alignment="TOP_LEFT">
            <VBox spacing="7" styleClass="form-pane" prefWidth="285" minWidth="260" maxWidth="310"
                  maxHeight="Infinity">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14"/>
                </padding>
                <Label text="Viaje activo" styleClass="field-label"/>
                <Label fx:id="lblViaje" text="Sin viaje asignado" styleClass="section-title" wrapText="true"/>
                <Label fx:id="lblRuta" text="—" wrapText="true"/>
                <Label fx:id="lblSla" text="—" wrapText="true" styleClass="status-label"/>
                <Separator/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Manejo acumulado" styleClass="metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblManejo" text="0 h 00 min" styleClass="metric-value cabina-metric"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Descanso restante" styleClass="metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDescanso" text="0 h 00 min" styleClass="metric-value cabina-metric"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Paso de la jornada" styleClass="metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblPaso" text="—" styleClass="metric-value cabina-metric"/>
                </HBox>

                <Separator/>
                <Label fx:id="lblSemaforo" text="Sin datos" styleClass="semaphore-chip" wrapText="true"/>
                <Label fx:id="lblMensaje" text="—" wrapText="true" styleClass="status-label"/>

                <Separator/>
                <Label text="Siguiente asignación" styleClass="field-label"/>
                <Label fx:id="lblSiguienteCarga" text="Sin siguiente asignación"
                       styleClass="metric-value cabina-metric" wrapText="true"/>
                <Label fx:id="lblSiguienteRuta" text="—" wrapText="true" styleClass="status-label"/>
                <Label fx:id="lblSiguienteSla" text="—" wrapText="true" styleClass="status-label"/>
            </VBox>

            <StackPane HBox.hgrow="ALWAYS" minWidth="460" minHeight="320" maxHeight="Infinity"
                       styleClass="map-panel">
                <VBox alignment="CENTER" spacing="10" maxWidth="520">
                    <FontIcon iconLiteral="fas-map-marked-alt" styleClass="map-placeholder-icon"/>
                    <Label text="Mapa de navegación" styleClass="map-placeholder-title"/>
                    <Label fx:id="lblMapaRuta" text="Sin ruta activa"
                           styleClass="map-placeholder-route" wrapText="true" textAlignment="CENTER"/>
                    <Label text="Aquí se mostrará el trayecto del viaje y el acceso a la navegación."
                           styleClass="map-placeholder-hint" wrapText="true" textAlignment="CENTER"/>
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="Google Maps" styleClass="map-badge"/>
                        <Label text="Ruta del viaje" styleClass="map-badge"/>
                    </HBox>
                </VBox>
            </StackPane>
        </HBox>
    </center>

    <bottom>
        <VBox spacing="6">
            <padding>
                <Insets top="12"/>
            </padding>
            <Label fx:id="lblSugerencia" text="" wrapText="true" styleClass="status-label"/>
            <HBox spacing="10">
                <Button fx:id="btnIniciar" text="Iniciar trayecto" onAction="#iniciar"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-primary">
                    <graphic><FontIcon iconLiteral="fas-play"/></graphic>
                </Button>
                <Button fx:id="btnPausar" text="Pausa" onAction="#pausar"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-secondary">
                    <graphic><FontIcon iconLiteral="fas-pause"/></graphic>
                </Button>
                <Button fx:id="btnReanudar" text="Reanudar" onAction="#reanudar"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-success">
                    <graphic><FontIcon iconLiteral="fas-redo"/></graphic>
                </Button>
                <Button fx:id="btnConfirmar" text="Confirmar entrega" onAction="#confirmarEntrega"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-primary">
                    <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
