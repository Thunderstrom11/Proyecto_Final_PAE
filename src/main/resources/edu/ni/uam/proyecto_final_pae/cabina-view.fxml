<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.CabinaController"
            prefWidth="1040" prefHeight="680">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="6">
            <Label text="Cabina del operador" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Operador:"/>
                <ComboBox fx:id="cmbOperador" prefWidth="260"/>
                <Button text="Actualizar" onAction="#refrescar"/>
                <Label fx:id="lblEstado" text="Seleccione un operador."/>
            </HBox>
            <padding>
                <Insets bottom="10"/>
            </padding>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label fx:id="lblViaje" text="Sin viaje asignado" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <Label fx:id="lblRuta" text="—"/>
                <Label fx:id="lblSla" text="—" wrapText="true"/>
                <Separator/>
                <GridPane hgap="30" vgap="6">
                    <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Manejo acumulado" style="-fx-text-fill: #555555;"/>
                        <Label fx:id="lblManejo" text="0 h 00 min" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Descanso acumulado" style="-fx-text-fill: #555555;"/>
                        <Label fx:id="lblDescanso" text="0 h 00 min" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="2" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Paso de la jornada" style="-fx-text-fill: #555555;"/>
                        <Label fx:id="lblPaso" text="—" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                </GridPane>
                <Separator/>
                <Label fx:id="lblSemaforo" text="Sin datos"/>
                <Label fx:id="lblMensaje" text="—" wrapText="true" style="-fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="6" prefWidth="330">
                <Label text="Bitácora de eventos (registro_jornada)" style="-fx-font-weight: bold;"/>
                <ListView fx:id="lstBitacora" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="12"/>
            </padding>
            <Button fx:id="btnIniciar" text="Iniciar trayecto" onAction="#iniciar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnPausar" text="Pausa" onAction="#pausar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnReanudar" text="Reanudar" onAction="#reanudar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnConfirmar" text="Confirmar entrega" onAction="#confirmarEntrega"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
