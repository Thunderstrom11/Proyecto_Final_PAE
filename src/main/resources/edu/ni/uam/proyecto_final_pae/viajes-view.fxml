<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ni.uam.proyecto_final_pae.controller.ViajeController"
            prefWidth="980" prefHeight="700">
    <stylesheets>
        <URL value="@styles/fleetroute.css"/>
    </stylesheets>
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="4">
            <Label text="Gestión de viajes" styleClass="page-title"/>
            <Label fx:id="lblEstado" text="Listo." styleClass="status-label"/>
            <padding><Insets bottom="10"/></padding>
        </VBox>
    </top>

    <center>
        <BorderPane>
            <center>
                <VBox spacing="8">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <TextField fx:id="txtBuscarViaje" promptText="buscador" prefWidth="145">
                            <tooltip>
                                <Tooltip text="Busca por unidad, operador, número de carga o descripción."/>
                            </tooltip>
                        </TextField>
                        <Button fx:id="btnLimpiarBusquedaViaje" styleClass="btn-ghost"
                                onAction="#limpiarBusquedaViaje">
                            <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
                        </Button>
                        <TextField fx:id="txtCobroMin" promptText="Cobro mín." prefWidth="90"/>
                        <TextField fx:id="txtCobroMax" promptText="Cobro máx." prefWidth="90"/>
                        <TextField fx:id="txtBuscarRuta" promptText="buscador" prefWidth="120">
                            <tooltip>
                                <Tooltip text="Busca por el origen o el destino del viaje según el radio seleccionado."/>
                            </tooltip>
                        </TextField>
                        <RadioButton fx:id="rbOrigen" text="Origen" selected="true"/>
                        <RadioButton fx:id="rbDestino" text="Destino"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="actions-bar">
                        <Label text="Filtrar por" styleClass="field-label"/>
                        <Button fx:id="btnVerTodos" text="Todos"
                                styleClass="btn-secondary" onAction="#verTodos">
                            <graphic><FontIcon iconLiteral="fas-list"/></graphic>
                        </Button>
                        <Button fx:id="btnVerActivos" text="Activos"
                                styleClass="btn-secondary" onAction="#verActivos">
                            <graphic><FontIcon iconLiteral="fas-truck-moving"/></graphic>
                        </Button>
                        <Button fx:id="btnVerFinalizados" text="Finalizados"
                                styleClass="btn-secondary" onAction="#verFinalizados">
                            <graphic><FontIcon iconLiteral="fas-check-double"/></graphic>
                        </Button>
                        <Button fx:id="btnFinalizar" text="Finalizar entrega"
                                styleClass="btn-success" onAction="#finalizar">
                            <graphic><FontIcon iconLiteral="fas-check-circle"/></graphic>
                        </Button>
                    </HBox>
                    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="75"/>
                            <TableColumn fx:id="colOperador" text="Operador" prefWidth="110"/>
                            <TableColumn fx:id="colCarga" text="Carga" prefWidth="75"/>
                            <TableColumn fx:id="colOrigen" text="Origen" prefWidth="85"/>
                            <TableColumn fx:id="colDestino" text="Destino" prefWidth="85"/>
                            <TableColumn fx:id="colCobro" text="Cobro" prefWidth="75"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="85"/>
                        </columns>
                    </TableView>
                </VBox>
            </center>

            <right>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            prefWidth="296" styleClass="form-scroll">
                    <content>
                        <VBox spacing="6" prefWidth="280" styleClass="form-pane">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="14"/>
                            </padding>

                            <CheckBox fx:id="chkEncadenado" text="Viaje encadenado (usa viaje previo)"/>
                            <Label text="Viaje previo (solo si encadenado)"/>
                            <ComboBox fx:id="cmbViajePrevio" maxWidth="Infinity" disable="true"/>

                            <Label text="Unidad *"/>
                            <ComboBox fx:id="cmbUnidad" maxWidth="Infinity"/>

                            <Label text="Operador *"/>
                            <ComboBox fx:id="cmbOperador" maxWidth="Infinity"/>

                            <Label text="Carga pendiente *"/>
                            <ComboBox fx:id="cmbCarga" maxWidth="Infinity"/>

                            <Label text="Origen *"/>
                            <ComboBox fx:id="cmbOrigen" maxWidth="Infinity"/>

                            <Label text="Destino *"/>
                            <ComboBox fx:id="cmbDestino" maxWidth="Infinity"/>

                            <Label text="Tiempo estimado *"/>
                            <TextField fx:id="txtTiempo" promptText="Se calcula al elegir origen y destino"
                                       editable="false"/>

                            <Label text="Cobro del viaje *"/>
                            <TextField fx:id="txtCobro" promptText="1500.00"/>

                            <Separator/>
                            <Button fx:id="btnCrear" text="Crear viaje" maxWidth="Infinity"
                                    styleClass="btn-primary" onAction="#crear">
                                <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                            </Button>
                            <Button fx:id="btnLimpiar" text="Limpiar formulario" maxWidth="Infinity"
                                    styleClass="btn-ghost" onAction="#limpiar">
                                <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                            </Button>
                        </VBox>
                    </content>
                </ScrollPane>
            </right>
        </BorderPane>
    </center>
</BorderPane>
