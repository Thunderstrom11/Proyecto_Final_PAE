<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.ni.uam.proyecto_final_pae.controller.LoginController"
      alignment="CENTER" spacing="12" prefWidth="460" prefHeight="620">
    <stylesheets>
        <URL value="@styles/fleetroute.css"/>
    </stylesheets>
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>

    <Label text="FleetRoute Pro" styleClass="page-title"/>
    <Label fx:id="lblEmpresa" text="Sistema de despacho de cargas" styleClass="status-label"/>
    <Separator/>

    <Label text="Ingrese como" styleClass="field-label" maxWidth="Infinity"/>
    <HBox spacing="10" alignment="CENTER">
        <ToggleButton fx:id="tglAdmin" text="Administrador" styleClass="role-card" contentDisplay="TOP">
            <graphic><FontIcon iconLiteral="fas-user-shield"/></graphic>
        </ToggleButton>
        <ToggleButton fx:id="tglOperador" text="Operador" styleClass="role-card" contentDisplay="TOP">
            <graphic><FontIcon iconLiteral="fas-id-badge"/></graphic>
        </ToggleButton>
    </HBox>

    <Label text="Usuario" maxWidth="Infinity"/>
    <TextField fx:id="txtUsuario" promptText="su usuario"/>
    <Label text="Contraseña" maxWidth="Infinity"/>
    <PasswordField fx:id="txtPassword" onAction="#ingresar"/>

    <Button fx:id="btnIngresar" text="Ingresar" maxWidth="Infinity"
            styleClass="btn-primary" onAction="#ingresar" defaultButton="true">
        <graphic>
            <FontIcon iconLiteral="fas-sign-in-alt"/>
        </graphic>
    </Button>
    <Label fx:id="lblMensaje" textFill="#B42318" wrapText="true"/>
</VBox>